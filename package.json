  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check:format": "biome format --write src",
    "check:lint": "biome lint src && eslint . --fix --cache --max-warnings 0",
    "check:types": "tsc -b",
    "check:deps": "knip",
    "check:test": "vitest run --passWithNoTests --reporter=dot",
